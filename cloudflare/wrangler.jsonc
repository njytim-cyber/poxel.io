// Cloudflare Worker: website + multiplayer entrance. Deploy with: npm run deploy:cf
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "poxel",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist-cf",
    "binding": "ASSETS",
    // Multiplayer connects to the site's own address ("/"), so the Worker sees every request first
    "run_worker_first": true
  },
  // Secrets (not in this file): ORIGIN_URL (the game server's address) and ORIGIN_SECRET.
  // npm run host:cf sets both each time it starts the game server on this PC.
  "observability": { "enabled": true }
}
