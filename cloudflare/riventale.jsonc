// Cloudflare Worker for riventale.world. Account: tim@latticelogic.app ONLY (check with npx wrangler whoami).
// Deploy with: npm run deploy:riventale
// The old poxel.njytim.workers.dev site is cloudflare/wrangler.jsonc, in the njytim@gmail.com account.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "riventale",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Add once riventale.world is active in the account (it had no nameservers on 2026-10-03):
  // "routes": [{ "pattern": "riventale.world", "custom_domain": true }, { "pattern": "www.riventale.world", "custom_domain": true }],
  "assets": {
    "directory": "../dist-cf",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // Multiplayer is not set up here yet: without the ORIGIN_URL/ORIGIN_SECRET secrets the Worker answers
  // multiplayer connections with 503 and the game shows it as offline.
  "observability": { "enabled": true }
}
